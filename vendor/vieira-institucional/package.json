{
  "name": "@vieira/institucional",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "import": "./dist/sentry.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@sentry/react": ">=8.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/react": {
      "optional": true
    }
  }
}
